# Database Configuration (PostgreSQL)
DB_NAME=bus_booking_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Redis Cache Configuration
REDIS_PORT=6379

# Application Port
APP_PORT=8080

# Nginx Reverse Proxy Ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Spring Active Profile (default / test / prod)
SPRING_PROFILES_ACTIVE=default

# Docker Hub Credentials (Placeholders for CI/CD Registry Push)
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_personal_access_token
DOCKER_IMAGE=your_dockerhub_username/bus-booking-platform:1.0.0
